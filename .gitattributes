# Artifact hashes are compared across Windows and WSL checkouts of this
# same disk. A CRLF working tree makes the same run hash differently on
# each, which is exactly the comparison the stage artifacts exist for.
* text=auto eol=lf

# The F4 golden is a gzip. text=auto would guess, and a guess that goes
# wrong here silently rewrites the bytes the 556-pair regression reads.
*.gz binary
